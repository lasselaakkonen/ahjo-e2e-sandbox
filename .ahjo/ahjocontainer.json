{
  "name": "ahjo-e2e-sandbox",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "ubuntu"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/go:1": {},
    "ahjo/docker": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "tree"
    }
  },
  "postCreateCommand": "echo POST_CREATE_RAN > /tmp/ahjo-postcreate-marker",
  "customizations": {
    "ahjo": {
      "forward_env": [
        "AHJO_E2E_TOKEN"
      ]
    }
  }
}
